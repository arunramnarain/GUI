from tkinter import *
from tkinter.colorchooser import askcolor

class Paint(object):
    DEFAULT_color = "Blue"
    def __init__(self):

        self.root = Tk()
        self.root.config(bg = "yellow")
        self.root.geometry("400x400")

        self.pen_button = Button(self.root, text = "Pen", 
                                bg = "Green", bd = 4,
                                 fg = "pink", command=self.use_pen)
        self.pen_button.grid(row = 1, column = 1, padx = 5, pady = 5)

        self.brush_button = Button(self.root, text = "Brush", bg = "Green",
                                   fg = "pink", bd = 4, command = self.use_brush)
        self.brush_button.grid(row = 1, column = 2, padx =5, pady = 5)

        self.color_button = Button(self.root, text = "Colour", bg = "green", 
                                   bd = 4, fg = "pink",  command = self.choose_color)
        self.color_button.grid(row = 1, column = 3, padx = 5, pady = 5)

        self.eraser_button = Button(self.root, bg = "Green", text = "eraser",
                                    fg = "pink", bd = 4, command = self.use_eraser) 
        self.eraser_button.grid(row = 1, column = 4, padx = 5, pady = 5)

        self.choose_size_scale = Scale(self.root, from_ = 1, to = 20, bd = 4,
                                       bg = "green", fg = "pink", orient = "horizontal")
        self.choose_size_scale.grid(row = 1, column=5, padx = 5, pady = 5)

        self.clear = Button(self.root, bg = "Green", text = "clear", fg = "pink",
                            bd = 4, command = self.clear_canvas)
        self.clear.grid(row = 3, column = 1, padx = 5, pady = 5)

        self.C = Canvas(self.root, bg = "white", width = 375, height = 285)
        self.C.grid(row = 2, columnspan = 5, column = 1)

        self.setup()

        self.root.mainloop()


    def setup(self):
        self.old_x = None
        self.old_y = None
        self.line_width  = self.choose_size_scale.get()
        self.color = self.DEFAULT_color
        self.eraser_on = False
        self.active_button = self.pen_button
        self.C.bind("<B1-Motion>", self.paint)# bind is the function name and b1 
        # is the event name
        self.C.bind("<ButtonRelease-1>", self.reset)

    def use_pen(self):
        self.activate_button(self.pen_button)

    def use_brush(self):
        self.activate_button(self.brush_button)
    
    def choose_color(self):
        self.eraser_on = False
        self.color = askcolor(color = self.color)[1]
    
    def use_eraser(self):
        self.activate_button(self.eraser_button, eraser_mode = True)

    def clear_canvas(self):
        self.C.delete("all")

    def activate_button(self, some_button,eraser_mode = False):
        self.active_button.config(relief = RAISED)# reset the previously activated button to normal state
        some_button.config(relief = SUNKEN)# activates the click buttton
        self.active_button = some_button
        self.eraser_on = eraser_mode

    def paint(self,event):
        self.line_width = self.choose_size_scale.get()
        self.paint_color = "white" if self.eraser_on else self.color
        if self.old_x and self.old_y:
            self.C.create_line(self.old_x, self.old_y,
                                    event.x, event.y, 
                                    width = self.line_width, 
                                    fill = self.paint_color,
                                    capstyle = ROUND, # makes smooth rounded lines 
                                    smooth = TRUE, # enables line smoothing
                                    splinesteps = 36) # makes the curve smoother
        self.old_x = event.x
        self.old_y = event.y

    def reset(self, event):
        self.old_x = None
        self.old_y = None

            

 



if __name__ == "__main__":
    Paint()
