#initialising game board to play with pc

def with_pc(game_board):
    game_board.destroy()
    game_board = Tk()
    game_board.title("Tic toc game")

    l1 = Button(game_board, text  = "Player 1: X", width = 10, bg = "blue", fg = "yellow")
    l1.grid(row = 1, column = 1)

    l2 = Button(game_board, text = "Computer: O", width = 10, bg = "blue", fg = "yellow", state = DISABLED)
    l2.grid(row = 2, column  = 1)

    gameboard_pc(game_board, l1, l2)


def with_player(game_board):# initialising game board to playe eith another player
    game_board.destroy()
    game_board = Tk()
    game_board.title("Game Board")
    game_board.geometry("225x300")

    l1 = Button(game_board, text = "Player 1: X", width = 10, bg = "blue", fg = "yellow")
    l1.grid(row = 1, column = 1)

    l2 = Button(game_board, text = "Player 2: O", width = 10, bg = "blue", fg = "yellow", state = DISABLED)
    l2.grid(row = 2, column  = 1)

    gameboard_pl(game_board, l1, l2)

# main function

def Play():
    menu = Tk()
    menu.geometry("500x500")
    menu.title("Tic Tac Toe Game")
    wpl = partial(with_player, menu)
    head = Button(menu, text = "Welcome to the Tic Tac Toe game", 
                  activeforeground = "Black", activebackground = "Orange", 
                  fg = "Light Blue", bg = "White", width = 500, font = "summer", bd = 5)
    head.pack(side = "top")


    wpc = partial(with_pc, menu)

    b1 = Button(menu, text = "single player", activebackground = "Orange", 
                activeforeground = "Black", fg = "Light Blue", bg = "White",
                  font = "summer", bd = 5, command = wpc, width = 500)
    b1.pack(side = "top")
    
    b2 = Button(menu, text = "2 player", activebackground = "Orange", 
                activeforeground = "Black", fg = "Light Blue", bg = "White",
                  font = "summer", bd = 5, command = wpl, width = 500)
    b2.pack(side = "top")

    b3 = Button(menu, text = "Exit", activebackground = "Orange", 
                activeforeground = "Black", fg = "Light Blue", bg = "White",
                  font = "summer", bd = 5, command = menu.quit, width = 500)
    b3.pack(side = "top")

    menu.mainloop()

#Call main function, if 
if __name__ == "__main__":
    Play()

    
