import time
from tkinter import *
from tkinter import messagebox

root = Tk()
root.geometry("500x300")
root.title("Time counter")
root.config(bg = "Black")

hour = StringVar()
minute = StringVar()
second = StringVar()

hour.set("00")
minute.set("00")
second.set("00")

hour_entry = Entry(root,width = 4, font = ("Ariel",20,""), textvariable=hour)
minute_entry = Entry(root,width = 4, font = ("Ariel",20,""), textvariable=minute)
second_entry = Entry(root,width = 4, font = ("Ariel",20,""), textvariable=second)

hour_entry.grid(row = 2,column = 2, padx = 20, pady = 20)
minute_entry.grid(row = 2, column  = 3, padx =  20, pady = 20)
second_entry.grid(row = 2, column = 4, padx = 20,pady = 20)

def submit():
    try:
        temp = 3600 * int(hour.get()) + int(minute.get()) * 60 + int(second.get())

    except:
        print("Invalid input please add the valid entries")

    while temp > -1:
        mins, secs = divmod(temp,60)
        hours = 00
        if mins > 60:
            hours, mins = divmod(mins, 60)
        
        hour.set(f"{hours:02d}")
        minute.set(f"{mins:02d}")
        second.set(f"{secs:02d}")
        root.update()
        time.sleep(1)

        if temp == 0:
            messagebox.showinfo("Time Countdown", "Times up")
        
        temp -= 1

btn = Button(root, text = "set time countdown", bd = 4,
              bg = "Green", fg = "Blue", command = submit)
    
btn.grid(row = 3, column = 3)





root.mainloop()
