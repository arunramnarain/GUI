from tkinter import *
from tkinter.filedialog import *

root = Tk()
root.title("memorizer app")
root.minsize(350,300)

def open_file():
    fin = askopenfile(title = "Open File")
    if fin is not None:
        listbox.delete(0,END)
        items = fin.readlines()
        for item in items:
            listbox.insert(END, item.strip())

def save_file():
    fout = asksaveasfile(title = "Save File")
    if fout is not None:
        for item in listbox.get(0,END):
            print(item.strip(), file = fout)
        listbox.delete(0,END)

def add_item():
    listbox.insert(END, item.get())
    item.delete(0,END)

def delete():
    index = listbox.curselection()
    if index:
        listbox.delete(index)














# Creating GUI
fOpen = Button(root, command = open_file, text = "Open", bg = "blue", bd =5)
ldel = Button(root, command = delete, text = "Delete", bg = "green", bd=5)
fsave = Button(root, command = save_file, text = "Save", bg  = "yellow", bd =5)
ladd = Button(root, command = add_item, text = "Add", bg = "yellow",  bd  =5)

item = Entry(root, width = 35)

ladd.pack(side = TOP, pady = 5, padx = 30)
ldel.pack(side = RIGHT, padx = 10)
fsave.pack(side = TOP, padx = 30, pady = 5)
fOpen.pack(side = LEFT, padx = 10)

item.pack(side = TOP,  pady = 5)

frame = Frame(root)
scrollbar = Scrollbar(frame, orient = "vertical")
listbox = Listbox(frame, width = 70, yscrollcommand = scrollbar.set, bg = "red")





listbox.pack(side = LEFT, padx = 5)
scrollbar.pack(side = RIGHT, padx = 5, fill = Y)
scrollbar.config(command = listbox.yview)
frame.pack()

for i in range(1,101):
    listbox.insert(END, "LIST " + str(i))





root.mainloop()
