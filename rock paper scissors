from tkinter import *
import random
import tkinter.font as font

player_score = 0
computer_score = 0

options = [("Rock", 0),("Paper", 1), ("Scissors", 2)]

def computer_win():
    global computer_score, player_score
    computer_score += 1
    winner_label.config(text = "Computer Won!")
    computer_score_label.config(text = "computer score : " + str(computer_score))
    player_score_label.config(text = "player score : " + str(player_score))

def player_wins():
    global computer_score, player_score
    player_score += 1
    winner_label.config(text = "Player Won!")
    computer_score_label.config(text = "computer score : " + str(computer_score))
    player_score_label.config(text = "player score : " + str(player_score))


def tie():
    global computer_score, player_score
    winner_label.config(text = "Tie!")
    computer_score_label.config(text = "computer score : " + str(computer_score))
    player_score_label.config(text = "player score : " + str(player_score))

def get_computer_choice():
    return random.chocie(options)

def get_player_choice():
    pass

root = Tk()
root.geometry("800x400")
root.config(background = "red")
root.title("Rock Paper Scissors Game")

app_font = font.Font(size = 12)

game_title = Label(root,text = "Rock Paper Scissor", bg = "red", fg = "yellow", 
                   font = font.Font(size = 20))
game_title.pack()

winner_label = Label(root, text = "Lets Start The Game", bg = "red", fg = "yellow",
                      font = font.Font(size = 16))
winner_label.pack()

input_frame = Frame(root, bg = "Blue")
input_frame.pack()

player_options = Label(input_frame, text = "Your options: ",
                        bg = "blue", fg = "white", font = app_font)
player_options.grid(row = 0, column = 0, pady = 7)

rock = Button(input_frame, text = "Rock", bg = "orange", fg = "Black", bd = 5, 
              pady = 7, width = 15, command = None)
rock.grid(row = 1, column = 1, padx = 8)


paper = Button(input_frame, text = "Paper", bg = "orange", fg = "Black", bd = 5, 
              pady = 7, width = 15, command = None)
paper.grid(row = 1, column = 2, padx = 8)


scissors = Button(input_frame, text = "Scissors", bg = "orange", fg = "Black",
                   bd = 5, pady = 7, width = 15, command = None)
scissors.grid(row = 1, column = 3, padx = 8)

score_label = Label(input_frame, text = "score: ", bg = "Blue", fg = "white", 
                    font = app_font, pady=5)
score_label.grid(row = 3, column = 0)

player_choice_label = Label(input_frame, text = "you selected: ", bg = "Blue" , 
                            fg = "white", font = app_font, padx = 5, pady = 5)
player_score_label = Label(input_frame, text = "your score: ", bg = "Blue" , 
                            fg = "white", font = app_font, padx = 5, pady = 5)
player_choice_label.grid(row = 4, column = 0)
player_score_label.grid(row = 5, column = 0)

computer_choice_label = Label(input_frame, text = "computer selected: ", bg = "Blue" , 
                            fg = "white", font = app_font, padx = 5, pady = 5)
computer_score_label = Label(input_frame, text = "computer score: ", bg = "Blue", 
                            fg = "white", font = app_font, padx = 5, pady = 5)
computer_choice_label.grid(row = 4, column = 2)
computer_score_label.grid(row = 5, column = 2)

root.mainloop()
