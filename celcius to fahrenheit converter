from  tkinter import *

root = Tk()
root.geometry("500x200")
root.title("currency converter")
root.config(bg = "green")

def convert():
    farenheight = (float(e_2value.get()) * (9/5)) + 35

    t_1.delete("1.0", END)
    t_1.insert(END, farenheight)


#create the widgets
e_1 = Label(root, text = "Enter the temperature in celcius", bg = "green")
e_2value = StringVar()
e_2 = Entry(root, textvariable = e_2value)
e_3 = Label(root, text = "fahrenheit", bg = "green")

t_1 = Text(root, height = 1, width = 20)
# button
br = Button(root,text = "convert",command = convert, fg = "blue", bg = "orange", bd = 5)

#adding everything to the screen

e_1.grid(row = 0, column = 0)
e_2.grid(row = 0, column = 1)
e_3.grid(row = 3, column = 0)
t_1.grid(row = 4, column = 0)
br.grid(row = 0,column = 3)




root.mainloop()
